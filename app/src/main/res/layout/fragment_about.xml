<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FEF3EA"
    tools:context=".core.ui.components.aboutUs.AboutusFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:paddingBottom="36dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <TextView
            android:id="@+id/title_about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="About the team"
            android:textColor="#F37221"
            android:textSize="34sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:id="@+id/description_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RosSwap was developed with the goal of reducing environmental impact and making Roskilde Festival greener by promoting a circular economy. With the app we make it super easy to swap and reuse items between festivalgoers."
            android:textColor="#2E2E2E"
            android:textSize="18sp"
            android:lineSpacingExtra="6dp"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/description_middle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="We hope RosSwap becomes a practical and useful aid for you as a festival guest - and that it lives up to your expectations."
            android:textColor="#2E2E2E"
            android:textSize="18sp"
            android:lineSpacingExtra="6dp"
            android:gravity="center"
            android:layout_marginBottom="28dp"/>

        <TextView
            android:id="@+id/team_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Our team consists of:"
            android:textColor="#2E2E2E"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="18dp"/>

        <GridLayout
            android:id="@+id/team_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="2"
            android:alignmentMode="alignMargins"
            android:columnOrderPreserved="false"
            android:useDefaultMargins="true">

            <!-- Member 1 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="8dp">

                <ImageView
                    android:id="@+id/avatar1"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:padding="0dp"
                    android:cropToPadding="false"
                    android:background="@drawable/circle_white_bg"
                    android:clipToOutline="true"
                    android:contentDescription="avatar"
                    android:scaleType="centerCrop"
                    android:src="@drawable/team_hannah" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hannah Lund"
                    android:textSize="16sp"
                    android:textColor="#222222"
                    android:layout_marginTop="8dp"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- Member 2 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="8dp">
                <ImageView
                    android:id="@+id/avatar2"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:padding="0dp"
                    android:cropToPadding="false"
                    android:background="@drawable/circle_white_bg"
                    android:clipToOutline="true"
                    android:contentDescription="avatar"
                    android:scaleType="centerCrop"
                    android:src="@drawable/team_lilian" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lilian Osman"
                    android:textSize="16sp"
                    android:textColor="#222222"
                    android:layout_marginTop="8dp"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- Member 3 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="8dp">
                <ImageView
                    android:id="@+id/avatar3"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:padding="0dp"
                    android:cropToPadding="false"
                    android:background="@drawable/circle_white_bg"
                    android:clipToOutline="true"
                    android:contentDescription="avatar"
                    android:scaleType="centerCrop"
                    android:src="@drawable/team_philipp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Philipp\nZhuravlev"
                    android:textSize="16sp"
                    android:textColor="#222222"
                    android:layout_marginTop="8dp"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- Member 4 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="8dp">
                <ImageView
                    android:id="@+id/avatar4"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:padding="0dp"
                    android:cropToPadding="false"
                    android:background="@drawable/circle_white_bg"
                    android:clipToOutline="true"
                    android:contentDescription="avatar"
                    android:scaleType="centerCrop"
                    android:src="@drawable/team_criller" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Christian\nHyllested"
                    android:textSize="16sp"
                    android:textColor="#222222"
                    android:layout_marginTop="8dp"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- Member 5 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="8dp">
                <ImageView
                    android:id="@+id/avatar5"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:padding="0dp"
                    android:cropToPadding="false"
                    android:background="@drawable/circle_white_bg"
                    android:clipToOutline="true"
                    android:contentDescription="avatar"
                    android:scaleType="centerCrop"
                    android:src="@drawable/team_akkash" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Akkash\nVigneswaran"
                    android:textSize="16sp"
                    android:textColor="#222222"
                    android:layout_marginTop="8dp"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- Member 6 (Ollie Lazarotti) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="8dp">
                <ImageView
                    android:id="@+id/avatar6"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:padding="0dp"
                    android:cropToPadding="false"
                    android:background="@drawable/circle_white_bg"
                    android:clipToOutline="true"
                    android:contentDescription="avatar"
                    android:scaleType="centerCrop"
                    android:src="@drawable/olli" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ollie\nLazarotti"
                    android:textSize="16sp"
                    android:textColor="#222222"
                    android:layout_marginTop="8dp"
                    android:gravity="center"/>
            </LinearLayout>

        </GridLayout>

        <TextView
            android:id="@+id/section_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="This is where the idea for RosSwap was born."
            android:textColor="#2E2E2E"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="200dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="18dp">

            <ImageView
                android:id="@+id/party_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/team"
                android:contentDescription="party"/>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/description_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Shortly after we got the green light to make the dream a reality - and today we have the awesome app you’re using right now!"
            android:textColor="#2E2E2E"
            android:textSize="18sp"
            android:lineSpacingExtra="6dp"
            android:gravity="center"
            android:layout_marginTop="4dp"/>

    </LinearLayout>
</ScrollView>
