<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- shadow layer (offset slightly down to simulate elevation) -->
    <item android:left="0dp" android:top="3dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#33000000"/> <!-- semi-transparent black shadow -->
            <corners android:radius="20dp"/>
        </shape>
    </item>

    <!-- main white rounded box with dark stroke -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <stroke android:width="2dp" android:color="#222222"/>
            <corners android:radius="20dp"/>
            <padding android:left="12dp" android:top="10dp" android:right="12dp" android:bottom="10dp"/>
        </shape>
    </item>

</layer-list>
