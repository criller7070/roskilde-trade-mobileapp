rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public read for post images so both web and mobile can render imageUrl (download URLs are still unguessable due to token)
    match /posts/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default: keep everything else private
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}

